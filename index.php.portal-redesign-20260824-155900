      font-weight: 700;
      letter-spacing: -0.015em;
      line-height: 1.3;
    }

    .section-head p {
      margin-top: 6px;
      color: var(--muted);
      font-size: 0.875rem;
    }

    .head-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: var(--navy);
      font-size: 0.8125rem;
      font-weight: 600;
      white-space: nowrap;
      transition: gap var(--fast) var(--ease);
    }

    .head-link:hover { gap: 11px; }
    .head-link svg { width: 15px; height: 15px; }

    /* ── แถบชิป (แท็บหมวด) ── */
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 20px;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      height: 34px;
      padding: 0 13px;
      border: 1px solid var(--line-2);
      border-radius: var(--r-sm);
      background: var(--surface);
      color: var(--ink-2);
      font-size: 0.8125rem;
      font-weight: 600;
      white-space: nowrap;
      transition: background var(--fast) var(--ease), border-color var(--fast) var(--ease), color var(--fast) var(--ease);
    }

    .chip small {
      min-width: 20px;
      padding: 1px 5px;
      border-radius: var(--r-sm);
      background: var(--surface-3);
      color: var(--muted);
      font-size: 0.6875rem;
      font-weight: 700;
      text-align: center;
    }

    .chip:hover { border-color: var(--navy); color: var(--navy); }

    .chip[aria-selected="true"] {
      border-color: var(--navy);
      background: var(--navy);
      color: #ffffff;
    }

    .chip[aria-selected="true"] small { background: rgba(255, 255, 255, 0.2); color: #ffffff; }

    /* ══════════════════════════════════════════════════════════
       8. ประกาศ
       ══════════════════════════════════════════════════════════ */
    .news-wrap {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: clamp(18px, 2.2vw, 30px);
      align-items: start;
    }

    /* ── ประกาศเด่น ── */
    .news-feature {
      display: grid;
      grid-template-columns: minmax(0, 46%) minmax(0, 1fr);
      overflow: hidden;
      margin-bottom: 14px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface);
      box-shadow: var(--sh-1);
      transition: border-color var(--fast) var(--ease), box-shadow var(--fast) var(--ease);
    }

    .news-feature:hover { border-color: var(--navy-line); box-shadow: var(--sh-2); }

    .feature-media {
      position: relative;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: var(--surface-3);
    }

    .feature-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 600ms var(--ease);
    }

    .news-feature:hover .feature-media img { transform: scale(1.04); }

    .media-blank {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      color: var(--line-2);
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0.2em;
    }

    .date-tag {
      position: absolute;
      left: 0;
      top: 0;
      display: grid;
      place-items: center;
      min-width: 56px;
      padding: 8px 6px;
      background: var(--navy);
      color: #ffffff;
      text-align: center;
      line-height: 1.1;
    }

    .date-tag strong { font-size: 1.25rem; font-weight: 700; }
    .date-tag span { font-size: 0.6875rem; opacity: 0.85; }

    .feature-body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(18px, 2vw, 28px);
    }

    .news-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
    }

    .tag {
      display: inline-flex;
      align-items: center;
      height: 21px;
      padding: 0 8px;
      border-radius: var(--r-sm);
      font-size: 0.6875rem;
      font-weight: 700;
    }

    .tag-cat { background: var(--navy-soft); color: var(--navy); }
    .tag-new { background: var(--red-soft); color: var(--red); }
    .tag-pin { background: var(--amber-soft); color: var(--amber); }
    .news-when { color: var(--faint); font-size: 0.75rem; }

    .feature-body h3 {
      font-size: clamp(1rem, 1.5vw, 1.25rem);
      font-weight: 700;
      line-height: 1.45;
      text-wrap: pretty;
    }

    .feature-body p {
      margin-top: 10px;
      color: var(--muted);
      font-size: 0.875rem;
      line-height: 1.8;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .feature-more {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-top: 16px;
      color: var(--navy);
      font-size: 0.8125rem;
      font-weight: 600;
    }

    .feature-more svg { width: 15px; height: 15px; }

    /* ── รายการประกาศ ── */
    .news-list { display: grid; gap: 8px; }

    .news-row {
      position: relative;
      display: grid;
      grid-template-columns: 108px minmax(0, 1fr);
      gap: 14px;
      padding: 10px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface);
      transition: border-color var(--fast) var(--ease), background var(--fast) var(--ease);
    }

    .news-row:hover { border-color: var(--navy-line); background: var(--surface-2); }
    .news-row.is-pinned { border-left: 3px solid var(--amber); }

    .row-thumb {
      position: relative;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: var(--surface-3);
    }

    .row-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .row-thumb .media-blank { font-size: 0.625rem; }

    .row-body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-width: 0;
      padding-right: 8px;
    }

    .row-body h4 {
      font-size: 0.9375rem;
      font-weight: 600;
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .row-body p {
      margin-top: 5px;
      color: var(--muted);
      font-size: 0.8125rem;
      line-height: 1.65;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* ── แถบข้างประกาศ ── */
    .side-card {
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface);
      box-shadow: var(--sh-1);
    }

    .side-card + .side-card { margin-top: 14px; }

    .side-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 13px 15px;
      border-bottom: 1px solid var(--line);
      background: var(--surface-2);
    }

    .side-head h3 {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .side-head svg { width: 15px; height: 15px; color: var(--navy); }
    .side-body { padding: 6px 15px 14px; }

    .pin-item {
      display: block;
      padding: 11px 0;
      border-bottom: 1px dashed var(--line);
    }

    .pin-item:last-child { border-bottom: 0; }

    .pin-item span {
      display: block;
      color: var(--faint);
      font-size: 0.6875rem;
      margin-bottom: 3px;
    }

    .pin-item b {
      display: -webkit-box;
      font-size: 0.8125rem;
      font-weight: 600;
      line-height: 1.55;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color var(--fast) var(--ease);
    }

    .pin-item:hover b { color: var(--navy); }

    /* ── ทางลัดในแถบข้าง ── */
    .quick-link {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 11px 0;
      border-bottom: 1px dashed var(--line);
      font-size: 0.8125rem;
      font-weight: 600;
      transition: color var(--fast) var(--ease);
    }

    .quick-link:last-child { border-bottom: 0; }
    .quick-link:hover { color: var(--navy); }

    .quick-link .ql-ico {
      width: 30px;
      height: 30px;
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      border-radius: var(--r-sm);
      background: var(--surface-3);
      color: var(--navy);
    }

    .quick-link:hover .ql-ico { background: var(--navy-soft); }
    .quick-link .ql-ico svg { width: 16px; height: 16px; }
    .quick-link .ql-go { margin-left: auto; color: var(--faint); }
    .quick-link .ql-go svg { width: 14px; height: 14px; }

    /* ══════════════════════════════════════════════════════════
       9. ระบบงาน
       ══════════════════════════════════════════════════════════ */
    .apps-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .apps-bar .chips { margin-bottom: 0; }

    .app-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(212px, 1fr));
      gap: 10px;
    }

    .app {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 15px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface);
      text-align: left;
      transition: border-color var(--fast) var(--ease), box-shadow var(--fast) var(--ease), transform var(--fast) var(--ease);
    }

    .app::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: var(--navy);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform var(--base) var(--ease);
    }

    .app:hover {
      border-color: var(--navy-line);
      box-shadow: var(--sh-2);
      transform: translateY(-2px);
    }

    .app:hover::before { transform: scaleY(1); }

    .app-icon {
      width: 40px;
      height: 40px;
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface-2);
    }

    .app-icon img { width: 100%; height: 100%; object-fit: contain; }

    .app-text { flex: 1 1 auto; min-width: 0; }

    .app-text b {
      display: block;
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1.4;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .app-text span {
      display: -webkit-box;
      margin-top: 4px;
      color: var(--faint);
      font-size: 0.75rem;
      line-height: 1.6;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .app-out {
      position: absolute;
      top: 12px;
      right: 12px;
      color: var(--line-2);
      opacity: 0;
      transition: opacity var(--fast) var(--ease), color var(--fast) var(--ease);
    }

    .app-out svg { width: 14px; height: 14px; }
    .app:hover .app-out { opacity: 1; color: var(--navy); }

    .app.off { cursor: not-allowed; opacity: 0.62; }
    .app.off:hover { transform: none; box-shadow: none; border-color: var(--line); }
    .app.off:hover::before { transform: scaleY(0); }

    /* ══════════════════════════════════════════════════════════
       10. ปฏิทิน
       ══════════════════════════════════════════════════════════ */
    .cal-wrap {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(18px, 2.2vw, 30px);
      align-items: start;
    }

    .cal-card, .holiday-card {
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface);
      box-shadow: var(--sh-1);
    }

    .cal-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      padding: 14px 16px;
      border-bottom: 1px solid var(--line);
      background: var(--surface-2);
    }

    .seg {
      display: inline-flex;
      padding: 2px;
      border: 1px solid var(--line-2);
      border-radius: var(--r-sm);
      background: var(--surface);
    }

    .seg button {
      height: 28px;
      padding: 0 14px;
      border-radius: var(--r-sm);
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: 600;
      transition: background var(--fast) var(--ease), color var(--fast) var(--ease);
    }

    .seg button[aria-selected="true"] { background: var(--navy); color: #ffffff; }

    .month-nav {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .month-nav b {
      min-width: 132px;
      font-size: 0.875rem;
      font-weight: 700;
      text-align: center;
    }

    .month-nav button {
      width: 28px;
      height: 28px;
      display: grid;
      place-items: center;
      border: 1px solid var(--line-2);
      border-radius: var(--r-sm);
      color: var(--muted);
      transition: background var(--fast) var(--ease), color var(--fast) var(--ease);
    }

    .month-nav button:hover { background: var(--navy-soft); color: var(--navy); }
    .month-nav svg { width: 14px; height: 14px; }

    .cal-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 2px;
      padding: 14px 16px 16px;
    }

    .cal-dow {
      display: grid;
      place-items: center;
      height: 26px;
      color: var(--faint);
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .cal-day {
      position: relative;
      display: grid;
      place-items: center;
      aspect-ratio: 1 / 1;
      border-radius: var(--r-sm);
      font-size: 0.8125rem;
      font-variant-numeric: tabular-nums;
    }

    .cal-day.out { color: var(--line-2); }
    .cal-day.today { outline: 2px solid var(--navy); outline-offset: -2px; font-weight: 700; }

    .cal-day .mk {
      position: absolute;
      inset: 12%;
      width: 76%;
      height: 76%;
      opacity: 0.9;
    }

    .cal-day .mk + * { position: relative; }
    .cal-day.is-sunday, .cal-day.is-public, .cal-day.is-substitution,
    .cal-day.is-compensate, .cal-day.is-vacation, .cal-day.is-special { color: var(--ink); font-weight: 700; z-index: 0; }

    /* สีสัญลักษณ์ตามไฟล์ Excel ต้นฉบับ */
    .mk { fill: none; stroke-width: 1.6; }
    .m-sunday { stroke: #cbd5e1; fill: #f1f5f9; }
    .m-public { stroke: #dc2626; fill: #fee2e2; }
    .m-substitution { stroke: #ea580c; fill: #ffedd5; }
    .m-compensate { stroke: #0284c7; fill: #e0f2fe; }
    .m-vacation { stroke: #16a34a; fill: #dcfce7; }
    .m-special { stroke: #9333ea; fill: #f3e8ff; }

    .holiday-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 14px 16px;
      border-bottom: 1px solid var(--line);
      background: var(--surface-2);
    }

    .holiday-head h3 { font-size: 0.875rem; font-weight: 700; }
    .holiday-head span { color: var(--faint); font-size: 0.75rem; }

    .holiday-list { padding: 4px 16px 14px; max-height: 296px; overflow-y: auto; }

    .holiday {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 0;
      border-bottom: 1px dashed var(--line);
    }

    .holiday:last-child { border-bottom: 0; }

    .holiday-date {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      flex: 0 0 auto;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface-2);
      line-height: 1.05;
      text-align: center;
    }

    .holiday-date strong { font-size: 0.9375rem; font-weight: 700; }
    .holiday-date em { font-style: normal; color: var(--faint); font-size: 0.625rem; }

    .holiday-name { flex: 1 1 auto; min-width: 0; }
    .holiday-name b { display: block; font-size: 0.8125rem; font-weight: 600; line-height: 1.5; }
    .holiday-name span { color: var(--faint); font-size: 0.6875rem; }
    .holiday .mk { width: 17px; height: 17px; flex: 0 0 auto; }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      padding: 13px 16px;
      border-top: 1px solid var(--line);
      background: var(--surface-2);
      color: var(--muted);
      font-size: 0.75rem;
    }

    .legend > span { display: inline-flex; align-items: center; gap: 6px; }
    .legend .mk { width: 15px; height: 15px; }

    /* ══════════════════════════════════════════════════════════
       11. เอกสารองค์กร
       ══════════════════════════════════════════════════════════ */
    .org-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 12px;
    }

    .org-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 22px;
      border: 1px solid var(--line);
      border-top: 3px solid var(--navy);
      border-radius: var(--r-sm);
      background: var(--surface);
      box-shadow: var(--sh-1);
      transition: box-shadow var(--fast) var(--ease), transform var(--fast) var(--ease);
    }

    .org-card:hover { box-shadow: var(--sh-2); transform: translateY(-2px); }
    .org-card.is-green { border-top-color: var(--green); }
    .org-card.is-gold { border-top-color: var(--gold); }

    .org-card.off { cursor: default; opacity: 0.72; }
    .org-card.off:hover { transform: none; box-shadow: var(--sh-1); }

    .org-ico {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border-radius: var(--r-sm);
      background: var(--navy-soft);
      color: var(--navy);
    }

    .org-card.is-green .org-ico { background: var(--green-soft); color: var(--green); }
    .org-card.is-gold .org-ico { background: #fbf5e3; color: #a9861f; }
    .org-ico svg { width: 22px; height: 22px; }

    .org-card h3 { font-size: 1rem; font-weight: 700; }

    .org-card p {
      flex: 1 1 auto;
      color: var(--muted);
      font-size: 0.8125rem;
      line-height: 1.75;
    }

    .org-go {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: var(--navy);
      font-size: 0.8125rem;
      font-weight: 600;
    }

    .org-card.off .org-go { color: var(--faint); }
    .org-go svg { width: 15px; height: 15px; }

    /* ══════════════════════════════════════════════════════════
       12. ติดต่อ + แผนที่
       ══════════════════════════════════════════════════════════ */
    .contact-wrap {
      display: grid;
      grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
      gap: clamp(18px, 2.2vw, 30px);
      align-items: start;
    }

    .contact-stack { display: grid; gap: 12px; }

    .contact {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 18px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface);
      box-shadow: var(--sh-1);
      transition: border-color var(--fast) var(--ease), box-shadow var(--fast) var(--ease);
    }

    .contact:hover { border-color: var(--navy-line); box-shadow: var(--sh-2); }

    .contact-ico {
      width: 42px;
      height: 42px;
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      border-radius: var(--r-sm);
      background: var(--navy-soft);
      color: var(--navy);
    }

    .contact-ico.green { background: var(--green-soft); color: var(--green); }
    .contact-ico svg { width: 21px; height: 21px; }

    .contact-text { min-width: 0; }
    .contact-text b { display: block; font-size: 0.9375rem; font-weight: 700; }
    .contact-text > span { display: block; margin-top: 2px; color: var(--muted); font-size: 0.8125rem; }

    .contact-mail {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 9px;
      color: var(--navy);
      font-size: 0.8125rem;
      font-weight: 600;
      word-break: break-all;
    }

    .contact-mail svg { width: 14px; height: 14px; flex: 0 0 auto; }

    .map-card {
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface);
      box-shadow: var(--sh-1);
    }

    .map-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 13px 16px;
      border-bottom: 1px solid var(--line);
      background: var(--surface-2);
    }

    .map-head h3 { font-size: 0.875rem; font-weight: 700; }

    .map-frame {
      position: relative;
      aspect-ratio: 16 / 9;
      background: var(--surface-3);
    }

