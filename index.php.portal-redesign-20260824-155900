      $$('.news-feature[data-news], .news-row[data-news]').forEach(function (el) {
        var match = catId === '' || el.getAttribute('data-cat') === catId;
        el.style.display = match ? '' : 'none';
        if (match) { shown++; }
      });

      $$('.chip[data-cat]').forEach(function (b) {
        b.setAttribute('aria-selected', b.getAttribute('data-cat') === catId ? 'true' : 'false');
      });

      var none = $('#newsNone');
      if (none) { none.hidden = shown > 0; }
    }

