    function appMatchesQuery(a) {
      if (appQuery === '') { return true; }

      var q = appQuery;
      var row = appText[a.id] || {};
      var keys = ['th', 'en', 'my'];

      for (var i = 0; i < keys.length; i++) {
        var pair = row[keys[i]];
        if (!pair) { continue; }
        if (String(pair[0]).toLowerCase().indexOf(q) > -1) { return true; }
        if (String(pair[1]).toLowerCase().indexOf(q) > -1) { return true; }
      }

      return String(a.id).toLowerCase().indexOf(q) > -1;
    }

